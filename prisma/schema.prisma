generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Role {
  id        Int      @id @default(autoincrement())
  name      String   @unique // CLIENT, ADMIN, LIVREUR, MEMBER
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  users     User[]

  @@map("roles")
}

model User {
  id                String       @id @default(uuid())
  nom               String
  prenom            String
  email             String       @unique
  password          String
  telephone         String
  deuxiemeTelephone String?
  adresse           String?
  etat              String?
  roleId            Int          @default(1) // Default to CLIENT role (id=1)
  permissions       String?
  imageProfil       String?
  businessId        String?      // Primary business (for quick access)
  createdAt         DateTime     @default(now())
  role              Role         @relation(fields: [roleId], references: [id], onDelete: Restrict)
  apiKeys           ApiKey[]
  inventory         Inventory[]
  invoices          Invoice[]
  messages          Message[]
  parcels           Parcel[]
  pickups           Pickup[]
  returns           Return[]
  teamMembers       TeamMember[]
  tickets           Ticket[]
  webhooks          Webhook[]
  userBusinesses    UserBusiness[]
  business          Business?    @relation(fields: [businessId], references: [id], onDelete: SetNull)

  @@index([roleId])
  @@index([businessId])
  @@map("users")
}

model Parcel {
  id                String   @id @default(uuid())
  numero            String
  code              String   @unique
  destinataire      String
  telephone         String
  adresse           String
  ville             String
  statut            String
  statutFacturation String
  typeColis         String
  fraisLivraison    Float
  montantTotal      Float
  referenceColis    String
  referenceVendeur  String
  note              String?
  vendeurSecondaire String?
  derniereAction    String
  dateCreation      DateTime @default(now())
  userId            String   // User who created it (for audit)
  businessId        String?  // Business it belongs to (for multi-tenancy) - nullable for migration
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  business          Business? @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([businessId])
  @@index([code])
  @@index([statut])
  @@index([dateCreation])
  @@map("parcels")
}

model Pickup {
  id                String   @id @default(uuid())
  code              String   @unique
  statut            String
  ville             String
  nombreColis       Int      @default(0)
  dateDemande       DateTime @default(now())
  frais             Float    @default(0)
  nom               String
  telephone         String
  adresse           String
  note              String?
  vendeurSecondaire String?
  userId            String   // User who created it (for audit)
  businessId        String?  // Business it belongs to (for multi-tenancy) - nullable for migration
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  business          Business? @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([businessId])
  @@index([code])
  @@index([dateDemande])
  @@map("pickups")
}

model Ticket {
  id           String   @id @default(uuid())
  sujet        String
  description  String
  statut       String
  dateCreation DateTime @default(now())
  userId       String   // User who created it (for audit)
  businessId   String?  // Business it belongs to (for multi-tenancy) - nullable for migration
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  business     Business? @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([businessId])
  @@index([statut])
  @@map("tickets")
}

model Invoice {
  id           String   @id @default(uuid())
  numero       String   @unique
  montant      Float
  dateEmission DateTime @default(now())
  statut       String
  userId       String   // User who created it (for audit)
  businessId   String?  // Business it belongs to (for multi-tenancy) - nullable for migration
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  business     Business? @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([businessId])
  @@index([numero])
  @@map("invoices")
}

model Return {
  id          String   @id @default(uuid())
  numeroColis String
  raison      String
  dateDemande DateTime @default(now())
  statut      String
  userId      String   // User who created it (for audit)
  businessId  String?  // Business it belongs to (for multi-tenancy) - nullable for migration
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  business    Business? @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([businessId])
  @@index([numeroColis])
  @@map("returns")
}

model Inventory {
  id        String   @id @default(uuid())
  produit   String
  quantite  Int
  prix      Float
  dateAjout DateTime @default(now())
  userId    String   // User who created it (for audit)
  businessId String? // Business it belongs to (for multi-tenancy) - nullable for migration
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  business  Business? @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([businessId])
  @@map("inventory")
}

model TeamMember {
  id        String   @id @default(uuid())
  nom       String
  prenom    String
  email     String   @unique
  role      String
  dateAjout DateTime @default(now())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("team_members")
}

model Message {
  id         String   @id @default(uuid())
  expediteur String
  sujet      String
  contenu    String
  dateEnvoi  DateTime @default(now())
  lu         Boolean  @default(false)
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([lu])
  @@map("messages")
}

model City {
  id                  Int       @id @default(autoincrement())
  zoneId              Int?
  ville               String
  name                String?
  arabicName          String?
  price               Float
  delais              String?
  region              String?
  refusedCost         Float     @default(0)
  canceledCost        Float     @default(0)
  priceDriver         Float?
  refusedCostDriver   Float     @default(0)
  active              String?
  driverId            String?
  pickerId            String?
  note                String?
  comment             String?
  pickupDistrict      String?
  minPickup           Int       @default(0)
  feePickup           Float     @default(0)
  feePickupDriver     Float     @default(0)
  minPickupRequired   Int       @default(0)
  pickupEndTime       String?
  allowNewDestination String?
  deliveryDays        String?
  createdAt           String?
  updatedAt           DateTime?
  deletedAt           DateTime?

  @@index([ville])
  @@index([region])
  @@index([active])
  @@map("cities")
}

model ApiKey {
  id         String    @id @default(uuid())
  key        String    @unique
  name       String
  active     Boolean   @default(true)
  createdAt  DateTime  @default(now())
  lastUsedAt DateTime?
  userId     String    // User who created it (for audit)
  businessId String?   // Business it belongs to (for multi-tenancy) - nullable for migration
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  business   Business? @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([businessId])
  @@index([key])
  @@map("api_keys")
}

model Webhook {
  id              String    @id @default(uuid())
  url             String
  event           String
  secretKey       String    @unique
  active          Boolean   @default(true)
  createdAt       DateTime  @default(now())
  lastTriggeredAt DateTime?
  userId          String    // User who created it (for audit)
  businessId      String?   // Business it belongs to (for multi-tenancy) - nullable for migration
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  business        Business? @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([businessId])
  @@index([event])
  @@index([active])
  @@map("webhooks")
}

model Business {
  id           String   @id @default(uuid())
  businessName String   // Business/Brand name (renamed from nomMarque)
  siteUrl      String?
  ville        String?
  adresse      String?
  telephone    String?
  email        String?
  etat         String   @default("Active") // Active, Inactive, etc.
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Relations
  users         User[]
  userBusinesses UserBusiness[]
  parcels      Parcel[]
  pickups      Pickup[]
  tickets      Ticket[]
  invoices     Invoice[]
  returns      Return[]
  inventory    Inventory[]
  apiKeys      ApiKey[]
  webhooks     Webhook[]

  @@map("businesses")
  @@index([businessName])
  @@index([etat])
}

// Many-to-many relationship between Users and Businesses
model UserBusiness {
  id         String   @id @default(uuid())
  userId     String
  businessId String
  role       String   @default("member") // owner, admin, member
  createdAt  DateTime @default(now())

  // Relations
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@unique([userId, businessId])
  @@map("user_businesses")
  @@index([userId])
  @@index([businessId])
}

